{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "type": "commonjs",
    "main": "dist/handler.js",
    "scripts": {
        "clean": "rm -rf dist",
        "build": "pnpm run clean && esbuild src/handler.ts src/bounce-handler.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --sourcemap",
        "build:watch": "esbuild src/handler.ts src/bounce-handler.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --sourcemap --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint ."
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.978.0",
        "@aws-sdk/client-sesv2": "^3.987.0",
        "@aws-sdk/util-dynamodb": "^3.978.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.0",
        "@types/node": "^20.0.0",
        "esbuild": "^0.25.0",
        "typescript": "^5.0.0"
    }
}
