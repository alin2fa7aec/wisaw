{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": { "@wisaw/shared": ["../../packages/shared/src/index.ts"] },

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,

        "types": ["node"],
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
